# Salin file ini menjadi .env.local lalu isi dengan kredensial Firebase Anda.
# Kosongkan (atau jangan buat .env.local) untuk memakai mode demo.
#
# MODE DEMO (tanpa API key): data in-memory, PIN admin "1234".
# MODE FIREBASE: Auth + Firestore + Cloud Functions aktif.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Opsional: emulator lokal (firebase emulators:start) ---
# Set "true" untuk mengarahkan Auth/Firestore/Functions ke emulator.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
