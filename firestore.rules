rules_version = '2';

// ===========================================================================
// CafeQR — Firestore Security Rules (multi-tenant / white-label)
//
// Struktur data:
//   tenants/{slug}                      → profil cafe (nama, logo, tema)
//   tenants/{slug}/menu/{itemId}        → menu cafe
//   tenants/{slug}/orders/{orderId}     → pesanan cafe
//
// MODEL OTORISASI (custom claims Firebase Auth):
//   reseller: true          → boleh membuat/mengubah/menghapus tenant
//   admin_<slug>: true      → boleh mengelola menu & status pesanan <slug>
//   slug: "<slug>"          → slug tenant yang diadmini (kenyamanan UI)
//
// CATATAN: PIN tidak lagi menjadi pengamanan. Keamanan ditegakkan di sini
// berbasis Auth + claim. Pesanan pelanggan DIBUAT lewat Cloud Function
// `createOrder` (Admin SDK → bypass rules), sehingga client tidak bisa
// memalsukan harga/total.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isReseller() {
      return isSignedIn() && request.auth.token.reseller == true;
    }

    function isAdminOf(slug) {
      return isSignedIn()
        && (
          request.auth.token.reseller == true
          || request.auth.token['admin_' + slug] == true
        );
    }

    // ---- Tenant profile ---------------------------------------------------
    match /tenants/{slug} {
      // Profil dibaca bebas (branding publik).
      allow read: if true;

      // Hanya reseller yang boleh membuat/menghapus cafe.
      allow create: if isReseller();
      allow delete: if isReseller();

      // Update branding hanya oleh admin cafe terkait / reseller,
      // dan hanya field yang diizinkan.
      allow update: if isAdminOf(slug)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'tagline', 'logo', 'theme', 'owner', 'status']);

      // ---- Menu -----------------------------------------------------------
      match /menu/{itemId} {
        allow read: if true;
        // Hanya admin cafe terkait yang boleh mengubah menu.
        allow write: if isAdminOf(slug) && isValidMenuItem();
      }

      // ---- Orders ---------------------------------------------------------
      match /orders/{orderId} {
        allow read: if true;

        // Pesanan pelanggan dibuat HANYA via Cloud Function (Admin SDK).
        // Dari client TIDAK diizinkan sama sekali.
        allow create: if false;

        // Update status hanya oleh admin cafe terkait, dan hanya field
        // `status` dengan transisi yang sah (state machine).
        allow update: if isAdminOf(slug)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && isAllowedStatus(resource.data.status, request.resource.data.status);

        allow delete: if false;
      }
    }

    // ---- Validasi ---------------------------------------------------------

    function isKnownStatus(s) {
      return s in ['pending', 'preparing', 'ready', 'completed', 'cancelled'];
    }

    // State machine: status akhir tidak berubah; alur maju satu langkah.
    function isAllowedStatus(from, to) {
      return isKnownStatus(to)
        && (
          (from == 'pending'   && (to == 'preparing' || to == 'cancelled'))
          || (from == 'preparing' && (to == 'ready'      || to == 'cancelled'))
          || (from == 'ready'     && (to == 'completed'))
        );
    }

    function isValidMenuItem() {
      let d = request.resource.data;
      return d.name is string
        && d.name.size() > 0
        && d.name.size() < 120
        && d.price is number
        && d.price >= 0
        && d.price < 100000000;
    }
  }
}
